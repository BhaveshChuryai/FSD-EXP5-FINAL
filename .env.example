# Root / Frontend Environment Variables Example
# Vite automatically exposes variables prefixed with VITE_ to the client bundle

# Backend API Base URL (defaults to /api which is proxied to http://127.0.0.1:5000 by Vite)
VITE_API_BASE_URL=/api

# Set to true only if you wish to use the lightweight in-memory Vite mock plugin instead of Express backend
VITE_USE_MOCK_PLUGIN=false
