# =============================================================================
# Plottage Hub Frontend Client Environment Variables Template
# All variables consumed by Vite in the browser MUST start with VITE_
# =============================================================================

# --- LOCAL DEVELOPMENT & DOCKER COMPOSE DEPLOYMENT ---
# In local development or Docker Compose (port 80), leave relative to leverage reverse proxy:
VITE_API_BASE_URL=/api
VITE_SOCKET_URL=

# --- VERCEL PRODUCTION DEPLOYMENT ---
# When deployed to Vercel, set these environment variables in your Vercel Project Settings:
# Replace with your deployed Render backend service URL:
# VITE_API_BASE_URL=https://plottage-hub-backend.onrender.com/api
# VITE_SOCKET_URL=https://plottage-hub-backend.onrender.com

# Mock Plugin Toggle: Set to false to connect to the live Node/Express backend
VITE_USE_MOCK_PLUGIN=false
