{
  "name": "plottage-hub-backend",
  "version": "1.0.0",
  "description": "Plottage Hub REST API - FSD Experiments 4 & 5",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "bootstrap-admin": "node src/scripts/bootstrapAdmin.js",
    "view-db": "node src/scripts/viewDb.js",
    "backup": "node src/scripts/backupLocalDb.js",
    "migrate": "node src/scripts/migrateBackupToAtlas.js",
    "test": "node --test tests/api.test.js",
    "test:exp6": "node --test tests/experiment6.test.js",
    "test:exp8": "node --test tests/experiment8.test.js",
    "test:all": "node --test tests/api.test.js && node --test tests/experiment6.test.js && node --test tests/experiment8.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.12.0",
    "socket.io": "^4.8.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0"
  }
}
