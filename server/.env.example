# Plottage Hub Backend Environment Configuration Example
# Copy this file to .env and configure your local or hosted MongoDB URI

# Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String (Local default: mongodb://127.0.0.1:27017/plottage_hub)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/plottage_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/plottage_hub

# Allowed Frontend Client Origins (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# JWT Secret for Signing Authentication Tokens
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# JWT Expiration Period (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# Initial Administrator Bootstrap Credentials (used by server:bootstrap-admin)
ADMIN_EMAIL=admin@plottagehub.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=Plottage Hub SuperAdmin
ADMIN_PHONE=9820000001
