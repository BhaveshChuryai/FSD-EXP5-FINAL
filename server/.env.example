# =============================================================================
# Plottage Hub Backend Environment Variables Template (server/.env.example)
# Copy this file to .env and configure your production or development values.
# NEVER commit populated .env files with active credentials into version control!
# =============================================================================

# Server Port (Render dynamically assigns PORT in production)
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Express Trust Proxy Configuration
# Set to '1' on Render and Docker Compose to trust the immediate front-facing reverse proxy.
# Prevents ERR_ERL_UNEXPECTED_X_FORWARDED_FOR and ensures correct client IP resolution for rate limiting.
TRUST_PROXY=1

# MongoDB Connection String:
# - Local MongoDB: mongodb://127.0.0.1:27017/plottage_hub
# - MongoDB Atlas: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/plottage_hub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/plottage_hub

# Local MongoDB Fallback URI (used in non-production environments if Atlas connection drops)
LOCAL_MONGODB_URI=mongodb://127.0.0.1:27017/plottage_hub

# Allowed Frontend Client Origins (comma-separated if multiple):
# In development: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:80,http://localhost
# On Render (Production): https://<your-project>.vercel.app,https://your-custom-domain.com
CLIENT_ORIGIN=http://localhost:5173,http://localhost:80,http://localhost

# Optional: Set to true if deploying frontend on Vercel preview environments (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# JWT Secret for Signing Authentication Tokens (Use a strong random hex string, min 32 chars in production)
JWT_SECRET=your_jwt_super_secret_key_change_in_production_min_32_characters

# JWT Expiration Period (e.g. 24h, 7d)
JWT_EXPIRES_IN=24h

# Initial Administrator Bootstrap Credentials (used by server:bootstrap-admin)
ADMIN_EMAIL=admin@plottagehub.com
ADMIN_PASSWORD=YourSecureAdminPassword123!
ADMIN_NAME=Plottage Hub SuperAdmin
ADMIN_PHONE=9820000001
